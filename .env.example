# Copia questo file in ".env" e inserisci i valori del tuo progetto Supabase.
# Li trovi in Supabase: Project Settings -> API.

# URL del progetto (es. https://xxxxxxxx.supabase.co)
VITE_SUPABASE_URL=

# Chiave pubblica "anon" (NON la service_role: quella non va mai nel frontend)
VITE_SUPABASE_ANON_KEY=

# Chiave pubblica VAPID per le notifiche push (facoltativa finché non attivi il push).
# Generala con:  npx web-push generate-vapid-keys
VITE_VAPID_PUBLIC_KEY=

# DSN di Sentry per il monitoraggio degli errori in produzione (facoltativo).
# Lo trovi in Sentry: Project Settings -> Client Keys (DSN). È pubblico per natura.
VITE_SENTRY_DSN=
